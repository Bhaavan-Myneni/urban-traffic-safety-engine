# Application
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/traffic_safety
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=traffic_safety
POSTGRES_USER=traffic_user
POSTGRES_PASSWORD=changeme

# YOLOv8
YOLO_MODEL_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IOU_THRESHOLD=0.45

# Streamlit
STREAMLIT_SERVER_PORT=8501

# Airflow (when running locally)
AIRFLOW_HOME=./airflow
